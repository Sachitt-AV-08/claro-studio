{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node16",
    "outDir": "dist-electron",
    "rootDir": "src-electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "include": ["src-electron/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}